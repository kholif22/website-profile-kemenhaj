PORT=3000
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_minimal_32_karakter
NODE_ENV=development
# URL publik final, dipakai untuk canonical/sitemap (tanpa garis miring di akhir)
SITE_URL=
# Set 1 bila berada di belakang satu reverse proxy (Nginx/Cloudflare)
TRUST_PROXY=
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
# Jumlah file backup database yang disimpan oleh `npm run db:backup`
BACKUP_KEEP=30
# Batas maksimum baris per ekspor pengaduan (Excel/PDF)
EXPORT_MAX_ROWS=5000
# Kredensial admin awal (dipakai hanya saat seed pertama kali; ganti sandi setelah login)
ADMIN_EMAIL=admin@plhut-magetan.go.id
ADMIN_USERNAME=
ADMIN_PASSWORD=
